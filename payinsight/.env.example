# Copy to .env. Everything is optional: with nothing set, PayInsight runs on the
# rules planner and tries Heron on Modal, falling back to the semantic-layer compiler.
HERON_URL=https://assasinthe1--qwen7b-t2s-serve.modal.run
HERON_MODE=auto            # auto | off
GROQ_API_KEY=              # free key from console.groq.com (understanding + polishing)
GEMINI_API_KEY=            # free key from aistudio.google.com (backup)
PLANNER_MODE=auto          # auto | rules
POLISH=off                 # on: a hosted model may reword answers (numbers re-checked)
